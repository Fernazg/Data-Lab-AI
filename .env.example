# ── Claude Agent SDK ───────────────────────────────────────────────
# Clave de API de Anthropic (solo servidor; nunca se envía al navegador).
ANTHROPIC_API_KEY=
# Modelo y esfuerzo de los agentes. Esfuerzo más bajo = menor costo.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# Límites de gasto por ejecución de agente (USD) y de turnos.
AGENT_MAX_BUDGET_USD=0.50
AGENT_MAX_TURNS=16
# Tareas en paralelo como máximo.
AGENT_MAX_CONCURRENCY=2

# ── Persistencia (opcional) ───────────────────────────────────────
# Sin estas variables se usa un archivo local en .data/state.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Seguridad (opcional) ──────────────────────────────────────────
# Si se define, las acciones (crear proyectos, aprobar) exigen este token.
ADMIN_TOKEN=
